# name: test/sql/secretscan.test
# description: vgi-secretscan — secret_contains scalar + secret_scan table function (offline, redacted output, no network)
# group: [vgi_secretscan]

require-env VGI_SECRETSCAN_WORKER

# haybarn-unittest does NOT autoload the extension for `require vgi` (it is
# silently SKIPPED). Load it explicitly instead.
statement ok
LOAD vgi;

statement ok
ATTACH 'secretscan' AS secretscan (TYPE vgi, LOCATION '{VGI_SECRETSCAN_WORKER}');

# ---- secret_contains: predicate for filtering ----
# All fixtures below are CLEARLY FAKE, non-live test secrets.

# A fake AWS access key id -> true.
query T
SELECT secretscan.secret_contains('deploy AKIAZ3MZ7EXAMPLE4Q2T now');
----
true

# A fake Slack bot token -> true.
query T
SELECT secretscan.secret_contains('SLACK_TOKEN=xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx');
----
true

# Clean prose -> false.
query T
SELECT secretscan.secret_contains('the quick brown fox jumps over the lazy dog');
----
false

# NULL input -> NULL (DuckDB short-circuits NULL scalar inputs; never an error).
query T
SELECT secretscan.secret_contains(NULL);
----
NULL

# secret_contains works as a WHERE-clause filter over a column of values.
statement ok
CREATE TEMP TABLE blobs(id INTEGER, body VARCHAR);

statement ok
INSERT INTO blobs VALUES
  (1, 'nothing to see here'),
  (2, 'aws key AKIAZ3MZ7EXAMPLE4Q2T leaked'),
  (3, 'token xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx'),
  (4, 'SELECT * FROM users');

query I
SELECT count(*) FROM blobs WHERE secretscan.secret_contains(body);
----
2

# ---- secret_scan: one row per finding ----

# A single AWS key yields exactly one finding.
query I
SELECT count(*) FROM secretscan.secret_scan('deploy AKIAZ3MZ7EXAMPLE4Q2T now');
----
1

# The finding is redacted (never the raw key), at the right offset, with a
# high confidence for this structurally-distinctive rule.
query TTTIR
SELECT rule_id, description IS NOT NULL, match_redacted, start_offset, confidence
FROM secretscan.secret_scan('deploy AKIAZ3MZ7EXAMPLE4Q2T now');
----
aws-access-token	true	AKIA********4Q2T	7	0.95

# The redacted match must NOT contain the full raw secret.
query I
SELECT count(*) FROM secretscan.secret_scan('deploy AKIAZ3MZ7EXAMPLE4Q2T now')
WHERE match_redacted LIKE '%AKIAZ3MZ7EXAMPLE4Q2T%';
----
0

# Entropy is reported and positive for a real secret.
query T
SELECT entropy > 3.0 FROM secretscan.secret_scan('token xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx');
----
true

# A Slack token is detected and redacted.
query TT
SELECT rule_id, match_redacted
FROM secretscan.secret_scan('token xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx');
----
slack-bot-token	xoxb********UvWx

# Clean text yields zero rows.
query I
SELECT count(*) FROM secretscan.secret_scan('the quick brown fox jumps over the lazy dog');
----
0

# NULL text yields zero rows (not an error).
query I
SELECT count(*) FROM secretscan.secret_scan(NULL);
----
0

# Multiple distinct secrets in one blob produce multiple rows, ordered by offset.
query TI
SELECT rule_id, start_offset
FROM secretscan.secret_scan(
  E'aws AKIAZ3MZ7EXAMPLE4Q2T\nslack xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx')
ORDER BY start_offset;
----
aws-access-token	4
slack-bot-token	31

# Thresholding on confidence keeps only the structurally-certain leaks.
query I
SELECT count(*) FROM secretscan.secret_scan('deploy AKIAZ3MZ7EXAMPLE4Q2T now')
WHERE confidence >= 0.9;
----
1

# ---- composed: secret_scan x secret_detectors x secret_contains ----
# These mirror the composed example queries in internal/secretworker/examples.go.

# Enrich findings with the registry; the npm rule is outside the curated list.
query TTITT
SELECT f.rule_id, f.match_redacted, f.start_offset, d.provider, d.category FROM secretscan.main.secret_scan('AWS_ACCESS_KEY_ID=AKIAZ3MZ7EXAMPLE4Q2T SLACK_TOKEN=xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx NPM_TOKEN=npm_Zq8xK2vN7rT4mW9pL3sY6bH1cJ5dF0gA8eRt') AS f LEFT JOIN secretscan.main.secret_detectors AS d USING (rule_id) ORDER BY f.start_offset;
----
aws-access-token	AKIA********4Q2T	18	AWS	Cloud Keys
slack-bot-token	xoxb********UvWx	51	Slack	Chat Tokens
npm-access-token	npm_********8eRt	116	NULL	NULL

# Redacted matches never re-trip a detector.
query IT
SELECT count(*) AS findings, bool_or(secretscan.main.secret_contains(f.match_redacted)) AS leaks_after_redaction FROM secretscan.main.secret_scan('AWS_ACCESS_KEY_ID=AKIAZ3MZ7EXAMPLE4Q2T SLACK_TOKEN=xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx NPM_TOKEN=npm_Zq8xK2vN7rT4mW9pL3sY6bH1cJ5dF0gA8eRt') AS f;
----
3	false

# Registry coverage: which high-confidence detectors fired.
query TTT
SELECT d.rule_id, d.provider, count(f.rule_id) > 0 AS detected FROM secretscan.main.secret_detectors AS d LEFT JOIN secretscan.main.secret_scan('AWS_ACCESS_KEY_ID=AKIAZ3MZ7EXAMPLE4Q2T SLACK_TOKEN=xoxb-1234567890-1234567890123-AbCdEfGhIjKlMnOpQrStUvWx NPM_TOKEN=npm_Zq8xK2vN7rT4mW9pL3sY6bH1cJ5dF0gA8eRt') AS f USING (rule_id) WHERE d.confidence >= 0.9 GROUP BY d.rule_id, d.provider ORDER BY detected DESC, d.rule_id;
----
aws-access-token	AWS	true
slack-bot-token	Slack	true
azure-ad-client-secret	Azure	false
gcp-api-key	GCP	false
github-fine-grained-pat	GitHub	false
github-pat	GitHub	false
gitlab-pat	GitLab	false
jwt	JWT	false
private-key	PEM	false
stripe-access-token	Stripe	false

# A bare PEM header (no key body / END footer) is not a private-key finding.
query T
SELECT secretscan.secret_contains('-----BEGIN RSA PRIVATE KEY-----');
----
false

# Agent-task graders (vgi-agent-tests.yaml): providers_of_findings.
query T
SELECT DISTINCT d.provider FROM secretscan.main.secret_scan('ci.yml: AWS_KEY=AKIAZ3MZ7EXAMPLE4Q2T GH_TOKEN=ghp_Zq8xK2vN7rT4mW9pL3sY6bH1cJ5dF0gA8eRt NPM_TOKEN=npm_Zq8xK2vN7rT4mW9pL3sY6bH1cJ5dF0gA8eRt') AS f JOIN secretscan.main.secret_detectors AS d USING (rule_id) ORDER BY d.provider
----
AWS
GitHub

# Agent-task graders: unlisted_rule_findings.
query I
SELECT count(*) AS n FROM secretscan.main.secret_scan('GITLAB_TOKEN=glpat-Zq8xK2vN7rT4mW9pL3sY NPM_TOKEN=npm_Zq8xK2vN7rT4mW9pL3sY6bH1cJ5dF0gA8eRt api_key = "f3a9c2e17b4d8a6e0c5f2b9d1e7a4c8b"') AS f LEFT JOIN secretscan.main.secret_detectors AS d USING (rule_id) WHERE d.rule_id IS NULL
----
1
